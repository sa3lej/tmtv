tmtv.se {
    # Landing page
    handle / {
        root * /var/www/tmtv
        try_files /index.html
        file_server
    }

    # Session viewer — Caddy templates inject session name into
    # <title> and og:title for link previews (Slack, Discord, iMessage)
    @viewer path_regexp viewer ^/s/([a-zA-Z0-9_-]+)$
    handle @viewer {
        root * /var/www/tmtv
        templates
        rewrite * /viewer.html
        file_server
    }

    # Health check endpoint
    handle /healthz {
        reverse_proxy 127.0.0.1:4002
    }

    # SSE reverse proxy (token in path)
    handle /ws/* {
        reverse_proxy 127.0.0.1:4002 {
            flush_interval -1
            transport http {
                read_timeout 0
                write_timeout 0
            }
        }
    }

    # Static assets
    handle {
        root * /var/www/tmtv
        file_server
    }
}
