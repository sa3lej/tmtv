---
interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Share your terminal over SSH with tmtv — a modern tmate alternative built on tmux 3.6a. Pair program in your terminal. No plugins, no accounts.',
  canonicalUrl = 'https://tmtv.se/',
  ogImage = 'https://tmtv.se/screenshot-default.png',
} = Astro.props;
---
