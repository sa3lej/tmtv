---
import "../styles/site.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  current?: string;
  jsonLd?: object | object[];
}

const {
  title,
  description = 'tmtv shares a tmux session over SSH or in a browser. Open source, self-hostable, for Linux and macOS.',
  canonicalUrl = 'https://tmtv.se/',
  ogImage = 'https://tmtv.se/social-card.png',
  ogImageAlt = 'tmtv: share a tmux session over SSH or in a browser',
  ogType = 'website',
  current,
  jsonLd,
} = Astro.props;
const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
