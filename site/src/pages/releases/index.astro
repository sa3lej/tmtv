---
import Base from "../../layouts/Base.astro";
import { release } from "../../data/release";
---

<Base
  title="tmtv releases"
  description="tmtv release history: 3.0.0 (tmux 3.8, sharing protocol 11) and earlier versions, with release notes and upgrade guidance."
  canonicalUrl="https://tmtv.se/releases/"
  current="releases"
>
  <article class="prose">
    <h1>Releases</h1>
    <p>
      What changed in each version and what to do before upgrading. Downloads,
      checksums and older notes are on
      <a href="https://github.com/sa3lej/tmtv/releases">GitHub releases</a>.
    </p>
    <section class="release" aria-labelledby="r300">
      <p class="meta">{release.current} · {release.date} · current</p>
      <h2 id="r300"><a href="/releases/3-0/">tmtv 3.0.0</a></h2>
      <p>
        Moves to tmux 3.8, restores more screen state after a reconnect
        (text attributes, OSC 8 links, SIXEL images) and sends typed Unicode
        exactly. Uses sharing protocol 11, so hosts and relays must be upgraded
        together.
      </p>
    </section>
    <section class="release" aria-labelledby="r204">
      <p class="meta">2.0.4 · 6 September 2026</p>
      <h2 id="r204"><a href="https://github.com/sa3lej/tmtv/releases/tag/v2.0.4">tmtv 2.0.4</a></h2>
      <p>
        Kept sharing links across automatic reconnects of the same running host.
        A full restart of the host still creates new links.
      </p>
    </section>
  </article>
</Base>
