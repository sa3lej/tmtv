import SiteFooter from "../../components/SiteFooter.astro";
import { Content } from "../../../../docs/releases/v3.0.0.md";
import "../../styles/marketing.css";
---

<Base
  title="tmtv 3.0 preview — More of your terminal, shared"
  description="Explore the upcoming tmtv 3.0 release: tmux 3.8, richer terminal snapshots and Unicode sharing input. Read the coordinated host and relay upgrade guide."
  canonicalUrl="https://tmtv.se/releases/3-0/"
>
  <div class="marketing">
    <SiteNav />
    <article class="article wrap">
      <p class="eyebrow">
        <a href="/releases/">← RELEASE LOG</a>
      </p>
      <Content />
      <p>
        <a href="/#install">Install current stable →</a>
      </p>
    </article>
    <SiteFooter />
  </div>
</Base>
