---
import Base from "../../layouts/Base.astro";
import { compiledContent, getHeadings } from "../../../../docs/releases/v3.0.0.md";

// Put the upgrade warning and contents list after the title and date line.
const html = await compiledContent();
const splitAt = html.indexOf("</p>", html.indexOf("</h1>")) + "</p>".length;
const intro = html.slice(0, splitAt);
const body = html.slice(splitAt);

const sections = getHeadings().filter((heading) => heading.depth === 2);
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "tmtv 3.0.0 release notes and upgrade guide",
  datePublished: "2026-10-27",
  url: "https://tmtv.se/releases/3-0/",
  author: { "@type": "Person", name: "Lars-Erik Jonsson", url: "https://github.com/sa3lej" },
  about: { "@type": "SoftwareApplication", name: "tmtv", softwareVersion: "3.0.0" },
};
const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "tmtv", item: "https://tmtv.se/" },
    { "@type": "ListItem", position: 2, name: "Releases", item: "https://tmtv.se/releases/" },
    { "@type": "ListItem", position: 3, name: "3.0.0", item: "https://tmtv.se/releases/3-0/" },
  ],
};
---

<Base
  title="tmtv 3.0.0 release notes and upgrade guide"
  description="tmtv 3.0.0 moves to tmux 3.8 and sharing protocol 11. Hosts and relays must upgrade together; SSH guests need nothing new. What changed and how to upgrade."
  canonicalUrl="https://tmtv.se/releases/3-0/"
  ogType="article"
  current="releases"
  jsonLd={[schema, breadcrumbs]}
>
  <article class="prose">
    <p class="crumb"><a href="/releases/">Releases</a> / 3.0.0</p>
    <Fragment set:html={intro} />
    <p class="notice">
      <strong>Before you upgrade:</strong> 3.0 uses sharing protocol 11, which
      does not work with 2.x hosts or relays. Upgrade your hosting client and any
      relay you run together, then restart running hosts; that gives them new
      links. <a href="#upgrading">Read the upgrade steps</a>.
    </p>
    <nav class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ul class="plain-list">
        {sections.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
      </ul>
    </nav>
    <Fragment set:html={body} />
    <p><a href="/#install">Install the current release</a></p>
  </article>
</Base>
