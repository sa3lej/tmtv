---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { release } from "../data/release";
import "../styles/marketing.css";
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "tmtv",
  description:
    "Open-source terminal sharing over SSH and an optional web viewer.",
  url: "https://tmtv.se",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  softwareVersion: release.current,
  license: "https://github.com/sa3lej/tmtv/blob/develop/LICENSE",
  codeRepository: release.repository,
  author: { "@type": "Person", name: "Lars-Erik Jonsson" },
};
---

<Base
  title="tmtv — Share your terminal"
  description="Share your terminal over SSH or in a browser. tmtv is open source, built on tmux, and ready for pair programming, troubleshooting and teaching."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="marketing home">
    <SiteNav />
    <section class="intro wrap" aria-labelledby="intro-title">
      <div class="intro-copy">
        <div class="edition">
          <span>OPEN SOURCE / TERMINAL SHARING</span>
          <a href="/releases/3-0/">v{release.current} ↗</a>
        </div>
        <h1 id="intro-title">
          Your terminal,
          <br />
          <em>shared.</em>
        </h1>
        <p class="intro-lead">Work in the same terminal, from anywhere.</p>
        <p class="intro-text">
          Start a session on your machine. Invite someone over SSH, or let them
          follow along in a browser. Your shell, your tools, together.
        </p>
        <div class="intro-links">
          <a class="button primary" href="#install">
            Get started <span aria-hidden="true">↘</span>
          </a>
          <a class="under-link" href="#how-it-works">
            See how it works ↓
          </a>
        </div>
        <p class="intro-meta">
          Built on tmux <span>·</span> Linux &amp; macOS <span>·</span> No
          account
        </p>
      </div>
      <figure
        class="terminal-demo"
        aria-label="Illustration of a shared terminal session"
      >
        <div class="terminal-top">
          <span>
            tmtv <span class="slash">/</span> example
          </span>
          <span class="terminal-live">
            <i></i> CONNECTED
          </span>
        </div>
        <div class="terminal-screen">
          <p class="term-dim"># On the host</p>
          <p>
            <span class="prompt">$</span> tmtv
          </p>
          <div class="term-space"></div>
          <p class="term-dim"># On a guest machine</p>
          <p>
            <span class="prompt">$</span> ssh{" "}
            <span class="term-accent">TOKEN</span>@tmtv.se
          </p>
          <div class="term-space"></div>
          <p class="term-dim"># Now working in the shared session</p>
          <p>
            <span class="prompt">$</span> git status
          </p>
          <p class="term-muted">On branch main</p>
          <p class="term-muted">working tree clean</p>
          <p>
            <span class="prompt">$</span>{" "}
            <span class="term-cursor" aria-hidden="true"></span>
          </p>
        </div>
        <div class="terminal-bar">
          <span>0: shell*</span>
          <span>SSH / WEB</span>
        </div>
        <figcaption>
          Illustrative session · tokens shown are placeholders
        </figcaption>
      </figure>
    </section>
    <div class="ribbon">
      <div class="wrap">
        <span>ONE SESSION</span>
        <span aria-hidden="true">✳</span>
        <span>YOUR TERMINAL</span>
        <span aria-hidden="true">✳</span>
        <span>MORE THAN ONE PAIR OF HANDS</span>
      </div>
    </div>
    <section class="how wrap" id="how-it-works" aria-labelledby="how-title">
      <div class="section-index">
        <span>01 / THE IDEA</span>
        <span>HOST → GUEST</span>
      </div>
      <div class="how-grid">
        <div>
          <h2 id="how-title">
            How it works.
          </h2>
          <p>
            Keep working where you already work. tmtv connects people to a
            shared tmux session without asking them to change their setup.
          </p>
        </div>
        <div class="workflow">
          <article>
            <span class="number">01</span>
            <div>
              <h3>Start</h3>
              <p>
                Run <code>tmtv</code> on your machine. Your shell and tools stay
                there.
              </p>
            </div>
          </article>
          <article>
            <span class="number">02</span>
            <div>
              <h3>Invite</h3>
              <p>
                Share a read-write token for a collaborator, or a read-only
                token for an observer.
              </p>
            </div>
          </article>
          <article>
            <span class="number">03</span>
            <div>
              <h3>Work together</h3>
              <p>
                Guests connect with SSH. Enable web sharing when a browser is
                more convenient.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>
    <section class="install-band" id="install" aria-labelledby="install-title">
      <div class="wrap install-grid">
        <div class="install-intro">
          <span class="section-kicker">02 / GET STARTED</span>
          <h2 id="install-title">
            Install tmtv.
          </h2>
          <p>
            Install tmtv, then run <code>tmtv</code>. Your guests don't need to
            install it to join over SSH.
          </p>
          <a href="https://github.com/sa3lej/tmtv/releases/latest">
            Download binaries ↗
          </a>
        </div>
        <div class="install-commands">
          <div class="command-head">
            <strong>Install tmtv</strong>
            <span>LINUX / macOS</span>
          </div>
          <div class="command-option">
            <span>Install script</span>
            <div class="copy-row">
              <code id="install-command">{release.installer}</code>
              <button
                type="button"
                data-copy={release.installer}
                aria-label="Copy install script command"
              >
                Copy
              </button>
            </div>
          </div>
          <div class="command-option">
            <span>Homebrew · macOS</span>
            <div class="copy-row">
              <code id="brew-command">{release.homebrew}</code>
              <button
                type="button"
                data-copy={release.homebrew}
                aria-label="Copy Homebrew command"
              >
                Copy
              </button>
            </div>
          </div>
          <p id="copy-status" role="status" aria-live="polite"></p>
          <div class="command-bottom">
            <a href="/install.sh">Inspect the installer ↗</a>
            <span>STABLE {release.current}</span>
          </div>
        </div>
      </div>
    </section>
    <section class="details-section wrap" aria-labelledby="details-title">
      <div class="section-index">
        <span>03 / THE DETAILS</span>
        <span>BUILT FOR REAL WORK</span>
      </div>
      <div class="details-grid">
        <div>
          <h2 id="details-title">
            Sharing, on your terms.
          </h2>
          <p>
            Pair on a fix, walk through a command, or invite another set of
            eyes. Choose how each person joins.
          </p>
          <a
            class="under-link"
            href="https://github.com/sa3lej/tmtv#self-hosting"
          >
            Explore self-hosting ↗
          </a>
        </div>
        <div class="detail-list">
          <article>
            <span>01</span>
            <div>
              <h3>Read-write or read-only</h3>
              <p>
                Separate tokens let you invite someone to type or simply watch.
                Browser sharing and browser input are opt-in.
              </p>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <h3>Your choice of relay</h3>
              <p>
                Use the public service or run your own. The relay processes
                terminal data, so choose one you trust.
              </p>
            </div>
          </article>
          <article>
            <span>03</span>
            <div>
              <h3>Familiar tmux, shared</h3>
              <p>
                Windows, panes, colour and Unicode travel with the session.
                Version 3.0 is built on tmux 3.8.
              </p>
              <a href="/releases/3-0/">What's new in 3.0 ↗</a>
            </div>
          </article>
        </div>
      </div>
      <p class="security-note">
        <strong>A note on access.</strong> Treat session tokens as credentials.
        Named public URLs are not a substitute for a password. SSH transport is
        not end-to-end encryption through an untrusted relay.
      </p>
    </section>
    <section class="join-band">
      <div class="wrap join-grid" id="join">
        <div>
          <span class="section-kicker">HAVE AN INVITATION?</span>
          <h2>
            Join a session<span>.</span>
          </h2>
          <p>
            Enter the token or session name from your host. Web sharing must be
            enabled for the session.
          </p>
        </div>
        <form id="session-form">
          <label for="token">Session token or name</label>
          <div class="join-row">
            <input
              id="token"
              name="token"
              type="text"
              required
              maxlength="256"
              placeholder="Paste your token"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="join-error"
            />
            <button type="submit">Join ↗</button>
          </div>
          <p id="join-error" role="alert"></p>
          <p class="join-help">
            Have a full link? Open it directly in your browser.
          </p>
        </form>
      </div>
    </section>
    <SiteFooter />
  </div>
  <script>
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((button) =>
        button.addEventListener("click", async () => {
          const status = document.getElementById("copy-status")!;
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            status.textContent = "Command copied.";
            button.textContent = "Copied";
            setTimeout(() => {
              button.textContent = "Copy";
            }, 2000);
          } catch {
            status.textContent =
              "Copy unavailable. Select and copy the command manually.";
          }
        }),
      );
    document
      .getElementById("session-form")
      ?.addEventListener("submit", (event) => {
        event.preventDefault();
        const token = (
          document.getElementById("token") as HTMLInputElement
        ).value.trim();
        const error = document.getElementById("join-error")!;
        if (!/^[A-Za-z0-9_-]{1,256}$/.test(token)) {
          error.textContent =
            "Enter a session token or name, without a URL or spaces.";
          return;
        }
        error.textContent = "";
        window.location.assign("/s/" + encodeURIComponent(token));
      });
  </script>
</Base>
