---
import Base from '../layouts/Base.astro';
---

<Base title="tmtv — SSH terminal sharing built on modern tmux">
  <!-- Structured data -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "tmtv",
    "description": "Share your terminal over SSH with tmtv — a modern tmate alternative built on tmux 3.6a. Pair program in your terminal with read-write and read-only SSH tokens.",
    "url": "https://tmtv.se",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS",
    "license": "https://opensource.org/licenses/ISC",
    "softwareVersion": "2.0.4",
    "author": {
      "@type": "Person",
      "name": "Lars-Erik Jonsson",
      "url": "https://github.com/sa3lej"
    },
    "codeRepository": "https://github.com/sa3lej/tmtv",
    "downloadUrl": "https://tmtv.se/install.sh",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
  </script>

  <!-- Background gradients -->
  <div class="fixed inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_-10%,rgba(108,158,252,0.16)_0%,transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_85%_10%,rgba(192,132,252,0.14)_0%,transparent_55%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_120%,rgba(61,220,132,0.10)_0%,transparent_55%)]"></div>
    <!-- Faint terminal grid -->
    <div class="absolute inset-0 opacity-[0.18] [background-image:linear-gradient(rgba(255,255,255,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:42px_42px] [mask-image:radial-gradient(ellipse_at_50%_0%,black_0%,transparent_75%)]"></div>
  </div>

  <!-- Hero -->
  <div class="flex flex-col items-center justify-center min-h-[62vh] px-5 pt-16 pb-4 text-center">
    <div class="relative">
      <div class="absolute -inset-x-10 -inset-y-6 bg-[radial-gradient(ellipse_at_center,rgba(108,158,252,0.25)_0%,transparent_70%)] blur-2xl -z-10" aria-hidden="true"></div>
      <h1 class="font-mono text-6xl sm:text-7xl font-bold tracking-tight mb-3 bg-gradient-to-br from-tmtv-blue via-tmtv-purple to-tmtv-green bg-clip-text text-transparent">
        tmtv
      </h1>
    </div>
    <p class="text-gray-200 text-lg sm:text-xl tracking-wide font-normal mb-5 max-w-md">
      Share your terminal over SSH.
      <span class="text-gray-400">That's it.</span>
    </p>

    <!-- Trust pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-11">
      <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-medium text-tmtv-green bg-tmtv-green/10 border border-tmtv-green/20 px-2.5 py-1 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-tmtv-green motion-safe:animate-blink" aria-hidden="true"></span>
        v2.0.4
      </span>
      <span class="font-mono text-[11px] font-medium text-tmtv-blue bg-tmtv-blue/10 border border-tmtv-blue/20 px-2.5 py-1 rounded-full">built on tmux 3.6a</span>
      <span class="font-mono text-[11px] font-medium text-gray-300 bg-white/[0.04] border border-white/[0.08] px-2.5 py-1 rounded-full">ISC licensed</span>
    </div>

    <!-- SSH quickstart -->
    <div class="relative bg-gradient-to-b from-white/[0.05] to-white/[0.02] border border-white/[0.08] rounded-2xl p-7 sm:p-9 w-[540px] max-w-[92vw] backdrop-blur-xl shadow-2xl shadow-black/40 text-left">
      <div class="absolute inset-x-0 -top-px h-px bg-gradient-to-r from-transparent via-tmtv-blue/40 to-transparent" aria-hidden="true"></div>
      <h2 class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.18em] mb-4">Get started</h2>
      <div class="group bg-black/50 rounded-xl px-4 py-3.5 font-mono text-sm flex items-center justify-between gap-4 mb-5 border border-white/[0.05] ring-1 ring-inset ring-white/[0.02]">
        <code class="text-tmtv-green whitespace-nowrap overflow-x-auto"><span class="text-gray-500 select-none">$ </span>curl -fsSL https://tmtv.se/install.sh | sh</code>
        <button id="copy-btn" class="text-gray-400 hover:text-tmtv-green transition-colors shrink-0 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded" aria-label="Copy install command">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <div class="bg-black/50 rounded-xl p-4 font-mono text-[13px] text-gray-300 leading-relaxed space-y-1 border border-white/[0.05]">
        <div><span class="text-gray-500 select-none">$</span> <span class="text-tmtv-green">tmtv</span><span class="inline-block w-2 h-4 align-text-bottom ml-0.5 bg-tmtv-green/80 motion-safe:animate-blink" aria-hidden="true"></span></div>
        <div><span class="text-gray-500 select-none">#</span> <span class="text-gray-500">share the SSH token with your pair</span></div>
        <div><span class="text-gray-500 select-none">$</span> ssh <span class="text-tmtv-blue">TOKEN</span>@tmtv.se</div>
      </div>
      <p class="mt-3 text-xs text-gray-400">
        Linux and macOS. Or <code class="font-mono bg-white/5 px-1.5 py-0.5 rounded text-[11px] text-gray-300">brew install sa3lej/tap/tmtv</code> on macOS.
        Or build from <a href="https://github.com/sa3lej/tmtv" class="text-gray-300 hover:text-gray-200 transition-colors underline underline-offset-2 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded">source</a>.
      </p>

      <!-- Divider -->
      <div class="border-t border-white/[0.06] my-6"></div>

      <!-- View a session (secondary) -->
      <h3 class="text-[11px] font-medium text-gray-400 tracking-wide mb-3">View a session in the browser</h3>
      <form id="session-form" class="flex gap-2">
        <label for="token" class="sr-only">Session token</label>
        <input
          type="text"
          id="token"
          placeholder="session token"
          autocomplete="off"
          spellcheck="false"
          class="flex-1 bg-white/5 border border-white/[0.06] rounded-lg px-3 py-2.5 font-mono text-xs text-gray-200 placeholder:text-gray-400 outline-none focus:border-tmtv-blue/40 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 transition-colors"
        />
        <button
          type="submit"
          class="bg-white/[0.06] border border-white/[0.08] rounded-lg px-4 py-2.5 text-xs font-medium text-gray-300 hover:bg-white/[0.1] active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 focus-visible:ring-offset-2 focus-visible:ring-offset-tmtv-bg transition-all whitespace-nowrap"
        >
          Watch
        </button>
      </form>
      <p class="mt-2.5 text-[11px] text-gray-400 leading-relaxed">
        Or open a direct link: <code class="font-mono bg-white/5 px-1.5 py-0.5 rounded text-[11px]">/s/TOKEN</code>
      </p>
    </div>
  </div>

  <!-- Demo GIF -->
  <div class="max-w-2xl mx-auto px-5 pb-16">
    <div class="rounded-xl overflow-hidden border border-white/[0.06] shadow-2xl">
      <img
        src="/tmtv-demo.gif"
        alt="tmtv terminal sharing session — SSH pair programming with optional web viewer"
        class="w-full motion-safe:block motion-reduce:hidden"
      />
    </div>
    <p class="text-center text-[11px] text-gray-400 mt-3 motion-reduce:block hidden motion-reduce:visible">
      <a href="/tmtv-demo.gif" class="underline underline-offset-2 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded">View demo animation</a>
    </p>
  </div>

  <!-- How it works -->
  <div class="max-w-3xl mx-auto px-5 pb-20">
    <div class="text-center mb-10">
      <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-2">How it works</h2>
      <div class="mx-auto w-10 h-px bg-gradient-to-r from-transparent via-tmtv-blue/50 to-transparent" aria-hidden="true"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="relative bg-white/[0.02] border border-white/[0.06] rounded-2xl p-6">
        <div class="flex items-center justify-center w-9 h-9 rounded-full bg-tmtv-blue/10 border border-tmtv-blue/25 font-mono text-sm font-bold text-tmtv-blue mb-4" aria-hidden="true">1</div>
        <h3 class="text-sm font-semibold text-gray-200 mb-2">Share</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Run <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">tmtv</code>.
          You get two SSH tokens: read-write for your pair, read-only for spectators. Add a password to lock the door.
        </p>
      </div>
      <div class="relative bg-white/[0.02] border border-white/[0.06] rounded-2xl p-6">
        <div class="flex items-center justify-center w-9 h-9 rounded-full bg-tmtv-purple/10 border border-tmtv-purple/25 font-mono text-sm font-bold text-tmtv-purple mb-4" aria-hidden="true">2</div>
        <h3 class="text-sm font-semibold text-gray-200 mb-2">Connect</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Your pair runs <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">ssh TOKEN@tmtv.se</code> and lands in your session. No plugins, no accounts, no browser.
        </p>
      </div>
      <div class="relative bg-white/[0.02] border border-white/[0.06] rounded-2xl p-6">
        <div class="flex items-center justify-center w-9 h-9 rounded-full bg-tmtv-green/10 border border-tmtv-green/25 font-mono text-sm font-bold text-tmtv-green mb-4" aria-hidden="true">3</div>
        <h3 class="text-sm font-semibold text-gray-200 mb-2">Or use the browser</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Open the web viewer if you don't have a terminal handy. Watch, or type along with a read-write token. Zero install.
        </p>
      </div>
    </div>
  </div>

  <!-- Features -->
  <div class="max-w-4xl mx-auto px-5 pb-20">
    <div class="text-center mb-10">
      <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-2">Everything you get</h2>
      <div class="mx-auto w-10 h-px bg-gradient-to-r from-transparent via-tmtv-blue/50 to-transparent" aria-hidden="true"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">

      <!-- SSH sharing -->
      <div class="group bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-blue/30 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="w-9 h-9 rounded-lg bg-tmtv-blue/10 border border-tmtv-blue/20 flex items-center justify-center mb-3 text-tmtv-blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 17 10 11 4 5"/><line x1="12" x2="20" y1="19" y2="19"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">SSH sharing</h3>
        <p class="text-xs text-gray-400 leading-relaxed">Read-write and read-only tokens. Your pair edits, spectators just watch — all over plain SSH.</p>
      </div>

      <!-- Shared clipboard (NEW) -->
      <div class="group bg-white/[0.02] border border-tmtv-green/20 rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-green/40 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="flex items-start justify-between mb-3">
          <div class="w-9 h-9 rounded-lg bg-tmtv-green/10 border border-tmtv-green/20 flex items-center justify-center text-tmtv-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/></svg>
          </div>
          <span class="text-[9px] font-bold uppercase tracking-wider text-tmtv-green bg-tmtv-green/15 px-1.5 py-0.5 rounded">New</span>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">Shared clipboard</h3>
        <p class="text-xs text-gray-400 leading-relaxed">Copy once, paste everywhere. Yanks sync across every viewer — host and guests, SSH and web.</p>
      </div>

      <!-- Inline graphics / SIXEL (NEW) -->
      <div class="group bg-white/[0.02] border border-tmtv-purple/20 rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-purple/40 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="flex items-start justify-between mb-3">
          <div class="w-9 h-9 rounded-lg bg-tmtv-purple/10 border border-tmtv-purple/20 flex items-center justify-center text-tmtv-purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
          <span class="text-[9px] font-bold uppercase tracking-wider text-tmtv-purple bg-tmtv-purple/15 px-1.5 py-0.5 rounded">New</span>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">Inline graphics</h3>
        <p class="text-xs text-gray-400 leading-relaxed">SIXEL images render right in the terminal — and in the web viewer. Charts, previews, QR codes.</p>
      </div>

      <!-- Session security -->
      <div class="group bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-blue/30 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="w-9 h-9 rounded-lg bg-tmtv-blue/10 border border-tmtv-blue/20 flex items-center justify-center mb-3 text-tmtv-blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">Locked down</h3>
        <p class="text-xs text-gray-400 leading-relaxed">Password-protect any session. Modern SSH crypto, isolated per-session tokens — no weak algorithms.</p>
      </div>

      <!-- Modern tmux -->
      <div class="group bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-green/30 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="w-9 h-9 rounded-lg bg-tmtv-green/10 border border-tmtv-green/20 flex items-center justify-center mb-3 text-tmtv-green">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/><path d="M9 12h12"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">Modern tmux</h3>
        <p class="text-xs text-gray-400 leading-relaxed">Built on tmux 3.6a: popup menus, extended keys, split panes, true color — nine years past tmate.</p>
      </div>

      <!-- Web viewer -->
      <div class="group bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 hover:bg-white/[0.04] hover:border-tmtv-purple/30 motion-safe:transition-all motion-safe:duration-200 hover:-translate-y-0.5">
        <div class="w-9 h-9 rounded-lg bg-tmtv-purple/10 border border-tmtv-purple/20 flex items-center justify-center mb-3 text-tmtv-purple">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-200 mb-1.5">Web viewer</h3>
        <p class="text-xs text-gray-400 leading-relaxed">Watch or type along right in the browser. xterm.js rendering, themes, zero install.</p>
      </div>

    </div>

    <!-- Secondary trust row -->
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 mt-7 text-[11px] text-gray-400">
      <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-tmtv-green" aria-hidden="true"></span>Self-hostable — <code class="font-mono bg-white/5 px-1 rounded text-gray-300">docker compose up</code></span>
      <span class="text-white/15" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-tmtv-blue" aria-hidden="true"></span>Linux + macOS</span>
      <span class="text-white/15" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-tmtv-purple" aria-hidden="true"></span>Static binaries, zero deps</span>
      <span class="text-white/15" aria-hidden="true">·</span>
      <span class="inline-flex items-center gap-1.5"><span class="w-1 h-1 rounded-full bg-gray-500" aria-hidden="true"></span>ISC licensed</span>
    </div>
  </div>

  <!-- CI debugging -->
  <div class="max-w-3xl mx-auto px-5 pb-20">
    <div class="bg-gradient-to-b from-white/[0.04] to-white/[0.01] border border-white/[0.07] rounded-2xl p-6 sm:p-7">
      <div class="flex items-center gap-2.5 mb-3">
        <div class="w-8 h-8 rounded-lg bg-tmtv-purple/10 border border-tmtv-purple/20 flex items-center justify-center text-tmtv-purple shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 2 1.88 1.88"/><path d="M14.12 3.88 16 2"/><path d="M9 7.13v-1a3.003 3.003 0 1 1 6 0v1"/><path d="M12 20c-3.3 0-6-2.7-6-6v-3a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v3c0 3.3-2.7 6-6 6"/><path d="M12 20v-9"/><path d="M6.53 9C4.6 8.8 3 7.1 3 5"/><path d="M6 13H2"/><path d="M3 21c0-2.1 1.7-3.9 3.8-4"/><path d="M20.97 5c0 2.1-1.6 3.8-3.5 4"/><path d="M22 13h-4"/><path d="M17.2 17c2.1.1 3.8 1.9 3.8 4"/></svg>
        </div>
        <h3 class="text-sm font-semibold text-gray-200">Debug CI failures over SSH</h3>
      </div>
      <p class="text-xs text-gray-400 leading-relaxed mb-4">
        Drop <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">sa3lej/action-tmtv@v1</code> into your GitHub Actions workflow. When a job fails, SSH straight into the runner and debug it live. A drop-in replacement for <code class="font-mono text-[11px] bg-white/5 px-1.5 py-0.5 rounded text-gray-300">action-tmate</code>.
      </p>
      <div class="rounded-xl overflow-hidden border border-white/[0.06]">
        <div class="flex items-center gap-1.5 bg-white/[0.03] px-3.5 py-2 border-b border-white/[0.06]">
          <span class="w-2.5 h-2.5 rounded-full bg-tmtv-red/70" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-400/60" aria-hidden="true"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-tmtv-green/60" aria-hidden="true"></span>
          <span class="ml-2 font-mono text-[10px] text-gray-500">.github/workflows/ci.yml</span>
        </div>
        <div class="bg-black/50 p-4 font-mono text-[12px] text-gray-300 leading-relaxed">
          <div><span class="text-tmtv-purple">- name:</span> <span class="text-gray-300">Debug via SSH</span></div>
          <div><span class="text-gray-600">&nbsp;&nbsp;</span><span class="text-tmtv-purple">uses:</span> <span class="text-tmtv-blue">sa3lej/action-tmtv@v1</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Screenshots -->
  <div class="max-w-3xl mx-auto px-5 pb-20">
    <div class="text-center mb-8">
      <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-2">What it looks like</h2>
      <div class="mx-auto w-10 h-px bg-gradient-to-r from-transparent via-tmtv-green/50 to-transparent" aria-hidden="true"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <figure class="group rounded-xl overflow-hidden border border-white/[0.06] bg-white/[0.02] motion-safe:transition-all motion-safe:duration-200 hover:border-white/[0.12] hover:-translate-y-0.5">
        <img src="/screenshot-default.png" alt="tmtv default theme showing terminal output" class="w-full" loading="lazy" />
        <figcaption class="text-center text-[11px] text-gray-400 py-2.5 border-t border-white/[0.05]">Default theme</figcaption>
      </figure>
      <figure class="group rounded-xl overflow-hidden border border-white/[0.06] bg-white/[0.02] motion-safe:transition-all motion-safe:duration-200 hover:border-white/[0.12] hover:-translate-y-0.5">
        <img src="/screenshot-tmux.png" alt="tmtv viewer showing a normal tmux session with split panes" class="w-full" loading="lazy" />
