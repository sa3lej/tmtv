---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { release } from "../data/release";
import "../styles/marketing.css";
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "tmtv",
  description:
    "Open-source terminal sharing over SSH and an optional web viewer. Pair, troubleshoot and teach in the same terminal.",
  url: "https://tmtv.se",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Linux, macOS",
  softwareVersion: release.current,
  license: "https://github.com/sa3lej/tmtv/blob/develop/LICENSE",
  codeRepository: release.repository,
  author: { "@type": "Person", name: "Lars-Erik Jonsson" },
};
---

<Base
  title="tmtv — Your terminal. Better together."
  description="Share a terminal over SSH or in the browser. Pair, troubleshoot and teach with read-write and read-only access. Open source, self-hostable, built on tmux."
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="marketing">
    <SiteNav />
    <section class="hero wrap" aria-labelledby="hero-title">
      <div class="hero-copy">
        <a class="release-chip" href="/releases/3-0/">
          <span class="chip-dot" aria-hidden="true"></span> OUT NOW / tmtv{" "}
          {release.current} <span aria-hidden="true">↗</span>
        </a>
        <h1 id="hero-title">
          Your terminal.
          <br />
          <span>Better together.</span>
        </h1>
        <p class="hero-lead">
          Bring someone into the session.
          <br />
          Keep your tools, your shell, your flow.
        </p>
        <p class="hero-detail">
          Share over SSH. Invite a browser. Pair on a fix, walk through a
          command, or let the whole team watch.
        </p>
        <div class="actions">
          <a class="button primary" href="#install">
            Start sharing <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="#demo">
            Explore a session <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-meta">
          OPEN SOURCE <span>·</span> LINUX & macOS <span>·</span> NO ACCOUNT
          REQUIRED
        </p>
      </div>
      <figure
        class="session-preview"
        id="demo"
        aria-label="Illustrative terminal sharing example"
      >
        <div class="terminal-header">
          <span class="terminal-dots" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span>tmtv / working-together</span>
          <span class="terminal-signal" aria-hidden="true">
            ▂▄▆
          </span>
        </div>
        <div class="terminal-body">
          <div class="terminal-path">
            ~/projects/hello <span>on main</span>
          </div>
          <div class="terminal-command">
            <span>❯</span> tmtv
          </div>
          <div class="terminal-note">One terminal. A few good minds.</div>
          <div class="terminal-rule"></div>
          <div class="terminal-label">INVITE YOUR PAIR</div>
          <div class="terminal-ssh">
            ssh <span>TOKEN</span>@tmtv.se
          </div>
          <div class="terminal-label second">INVITE AN OBSERVER</div>
          <div class="terminal-ssh">
            ssh <span>RO_TOKEN</span>@tmtv.se
          </div>
          <div class="terminal-rule"></div>
          <div class="example-output" id="example-output" aria-live="polite">
            <p class="example-title">Work in the same session.</p>
            <p class="example-line">Your pair joins with a read-write token.</p>
            <p class="example-line">Both of you can type.</p>
          </div>
          <div class="terminal-prompt">
            <span>❯</span>
            <b class="cursor" aria-hidden="true"></b>
          </div>
        </div>
        <div class="terminal-status">
          <span>[0] hello: shell*</span>
          <span>SSH + WEB</span>
        </div>
        <div
          class="demo-options"
          role="group"
          aria-label="Explore sharing modes"
        >
          <button type="button" data-demo="pair" aria-pressed="true">
            01 / Pair
          </button>
          <button type="button" data-demo="watch" aria-pressed="false">
            02 / Watch
          </button>
          <button type="button" data-demo="reconnect" aria-pressed="false">
            03 / Reconnect
          </button>
        </div>
        <figcaption>
          INTERACTIVE EXAMPLE · PLACEHOLDER TOKENS, NOT A LIVE SESSION
        </figcaption>
      </figure>
    </section>
    <div class="principles wrap">
      <span>
        <b>SSH</b> Your favourite terminal
      </span>
      <span>
        <b>WEB</b> A link is enough to watch
      </span>
      <span>
        <b>YOU</b> Choose who can type
      </span>
    </div>

    <section class="section wrap" id="how-it-works" aria-labelledby="how-title">
      <div class="section-heading">
        <p class="eyebrow">A SHORT PATH TO WORKING TOGETHER</p>
        <h2 id="how-title">
          One starts.
          <br />
          Everyone joins in.
        </h2>
        <p>
          Run tmtv on the host. Your guests bring an SSH client—or, when you
          enable web sharing, just a browser.
        </p>
      </div>
      <div class="steps">
        <article>
          <span class="step-number">01</span>
          <h3>Open your session.</h3>
          <p>
            Start tmtv and work in a familiar tmux environment. Your shell and
            tools stay on your machine.
          </p>
          <code>tmtv</code>
        </article>
        <article>
          <span class="step-number">02</span>
          <h3>Choose the invitation.</h3>
          <p>
            Share the read-write token with a collaborator. Send a read-only
            token to people who just need to follow along.
          </p>
          <code>ssh TOKEN@tmtv.se</code>
        </article>
        <article>
          <span class="step-number">03</span>
          <h3>Open it to the browser.</h3>
          <p>
            Web sharing is your choice. Browser guests watch by default; typing
            needs a read-write token and your explicit input setting.
          </p>
          <code>tmtv set -g tmtv-web-sharing on</code>
        </article>
      </div>
    </section>

    <section class="release-feature wrap" aria-labelledby="new-title">
      <div class="release-feature-heading">
        <span class="eyebrow">THE NEXT CHAPTER / 3.0</span>
        <span class="outline-tag">BUILT ON tmux 3.8</span>
      </div>
      <div class="release-feature-grid">
        <div>
          <h2 id="new-title">
            More of your terminal.
            <br />
            <em>Shared faithfully.</em>
          </h2>
          <p>
            Colour. Unicode. Layouts. The details are the work. tmtv 3.0 brings
            a newer tmux core and a richer sharing protocol to keep more of that
            context together.
          </p>
          <a class="text-link" href="/releases/3-0/">
            Read the 3.0 release notes <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="release-points">
          <article>
            <span>01</span>
            <div>
              <h3>Modern tmux, shared.</h3>
              <p>
                A tmux 3.8 core with layout hierarchy, floating panes and
                linked-window state carried to the relay.
              </p>
            </div>
          </article>
          <article>
            <span>02</span>
            <div>
              <h3>Pick up the picture.</h3>
              <p>
                Richer reconnect snapshots restore supported screen state, text
                attributes, hyperlinks and SIXEL images within documented
                limits.
              </p>
            </div>
          </article>
          <article>
            <span>03</span>
            <div>
              <h3>Type what you mean.</h3>
              <p>
                Portable Unicode keystrokes and literal UTF-8 paste, with
                bracketed paste when the receiving application requests it.
              </p>
            </div>
          </article>
        </div>
      </div>
      <p class="upgrade-note">
        <strong>A coordinated upgrade.</strong> 3.0 requires matching hosting
        clients and relays. Upgrade hosting clients to {release.current} for the
        public service. Save work before restarting hosts; new sessions use new links.
      </p>
    </section>

    <section class="section wrap" aria-labelledby="use-title">
      <div class="section-heading inline-heading">
        <div>
          <p class="eyebrow">GOOD COMPANY FOR REAL WORK</p>
          <h2 id="use-title">
            For the “come look at this”
            <br />
            moments.
          </h2>
        </div>
        <p>Keep the conversation close to the command line.</p>
      </div>
      <div class="use-cases">
        <article>
          <div class="use-symbol" aria-hidden="true">
            &gt;_ &gt;_
          </div>
          <h3>Pair on a tricky fix.</h3>
          <p>
            Use the same shell, inspect the same output, and take turns at the
            keyboard. No editor extension required.
          </p>
          <span class="small-label">DEVELOPERS & MAINTAINERS</span>
        </article>
        <article>
          <div class="use-symbol" aria-hidden="true">
            [ ! ]
          </div>
          <h3>Get another set of eyes.</h3>
          <p>
            Walk a teammate through logs or a failing command. Let observers
            follow without giving them input access.
          </p>
          <span class="small-label">OPERATIONS & TROUBLESHOOTING</span>
        </article>
        <article>
          <div class="use-symbol" aria-hidden="true">
            ./show
          </div>
          <h3>Make the lesson live.</h3>
          <p>
            Show a workflow in the browser. Record the session as an asciinema
            cast when you want something to revisit.
          </p>
          <span class="small-label">TEACHING & LIVE DEMOS</span>
        </article>
      </div>
    </section>

    <section class="control-section wrap" aria-labelledby="control-title">
      <div>
        <p class="eyebrow">YOUR SESSION. YOUR CALL.</p>
        <h2 id="control-title">Invite deliberately.</h2>
        <p>
          Read-only and read-write access are separate. Web sharing and browser
          input are opt-in. Add a session password, or run your own relay.
        </p>
        <a class="text-link" href="https://github.com/sa3lej/tmtv#self-hosting">
          Explore self-hosting ↗
        </a>
      </div>
      <div class="control-facts">
        <p>
          <span>01</span> View-only guests stay view-only.
        </p>
        <p>
          <span>02</span> You choose when the browser can type.
        </p>
        <p>
          <span>03</span> Open code. Your own relay if you want it.
        </p>
        <small>
          The relay processes terminal data, so use one you trust. Treat access
          tokens as credentials. Named public URLs are not a substitute for a
          password.
        </small>
      </div>
    </section>

    <section
      class="section wrap install-section"
      id="install"
      aria-labelledby="install-title"
    >
      <div class="section-heading">
        <p class="eyebrow">BRING YOUR TERMINAL</p>
        <h2 id="install-title">
          The next session
          <br />
          starts here.
        </h2>
        <p>
          Install the current stable release, then run <code>tmtv</code>.
          Joining over SSH requires no tmtv installation on your guest’s
          machine.
        </p>
        <p class="stable-label">
          STABLE {release.current} <span>·</span> PROTOCOL 11
        </p>
      </div>
      <div class="install-card">
        <div class="install-card-head">
          <h3>Install tmtv</h3>
          <span>Linux / macOS</span>
        </div>
        <div class="command-option">
          <p class="command-label">Install script</p>
          <div class="copy-row">
            <code id="install-command">{release.installer}</code>
            <button
              type="button"
              data-copy={release.installer}
              aria-label="Copy install script command"
            >
              Copy
            </button>
          </div>
        </div>
        <div class="command-option">
          <p class="command-label">Homebrew · macOS</p>
          <div class="copy-row">
            <code id="brew-command">{release.homebrew}</code>
            <button
              type="button"
              data-copy={release.homebrew}
              aria-label="Copy Homebrew command"
            >
              Copy
            </button>
          </div>
        </div>
        <p id="copy-status" role="status" aria-live="polite"></p>
        <p class="install-links">
          <a href="https://github.com/sa3lej/tmtv/releases/latest">
            Download binaries ↗
          </a>
          <a href="/install.sh">Inspect the installer ↗</a>
        </p>
        <p class="fine-print">
          The installer follows the published release. A 3.0 host will need a
          3.0 relay; wait for the announced service cutover before upgrading a
          public-service host.
        </p>
      </div>
    </section>

    <section class="join-section wrap" id="join" aria-labelledby="join-title">
      <div>
        <p class="eyebrow">ALREADY HAVE AN INVITATION?</p>
        <h2 id="join-title">Pull up a terminal.</h2>
        <p>
          Enter the token or session name your host gave you.
          <br />
          The host must have web sharing enabled.
        </p>
      </div>
      <form id="session-form">
        <label for="token">Session token or name</label>
        <div class="join-row">
          <input
            id="token"
            name="token"
            type="text"
            required
            maxlength="256"
            placeholder="Your session token"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="join-error"
          />
          <button class="button primary" type="submit">
            Join <span aria-hidden="true">↗</span>
          </button>
        </div>
        <p id="join-error" role="alert"></p>
        <p class="fine-print">
          Got a full link? Open it directly in your browser.
        </p>
      </form>
    </section>

    <section class="section wrap faq-section" aria-labelledby="faq-title">
      <div>
        <p class="eyebrow">A FEW THINGS WORTH KNOWING</p>
        <h2 id="faq-title">Before you connect.</h2>
      </div>
      <div class="faq-list">
        <details>
          <summary>Is this a screen-sharing app?</summary>
          <p>
            tmtv shares terminal sessions. For a desktop GUI, voice or video,
            use a screen-sharing or calling tool alongside it.
          </p>
        </details>
        <details>
          <summary>Can someone watch without typing?</summary>
          <p>
            Yes. Use a read-only token. Browser input is also off by default;
            enabling it still does not give a read-only guest write access.
            Shared clipboard access excludes read-only viewers.
          </p>
        </details>
        <details>
          <summary>What happens if the connection drops?</summary>
          <p>
            The same running host can reconnect automatically and retain its
            identity and links. Restarting the host creates fresh credentials.
            Session names are availability-based, so a name collision during a
            gap can change a link.
          </p>
        </details>
        <details>
          <summary>Is tmtv 3.0 ready to install?</summary>
          <p>
            Yes. The published stable release is{" "}
            {release.current}. Host and relay must upgrade together for 3.0; see
            the <a href="/releases/3-0/">release notes and upgrade guide</a>{" "}
            before changing versions.
          </p>
        </details>
        <details>
          <summary>Where does the terminal data go?</summary>
          <p>
            Through the configured relay, which processes the session and serves
            viewers. SSH transport encryption is not end-to-end encryption from
            host to guest through an untrusted relay. Self-host if you need to
            control that infrastructure.
          </p>
        </details>
      </div>
    </section>
    <SiteFooter />
  </div>
  <script>
    const modes = {
      pair: [
        "Work in the same session.",
        "Your pair joins with a read-write token.",
        "Both of you can type.",
      ],
      watch: [
        "Let the team follow along.",
        "An observer joins with a read-only token.",
        "They can see the output, but cannot type.",
      ],
      reconnect: [
        "Same running host. Same identity.",
        "Automatic reconnects retain sharing credentials.",
        "A full host restart creates fresh links.",
      ],
    };
    document
      .querySelectorAll<HTMLButtonElement>("[data-demo]")
      .forEach((button) =>
        button.addEventListener("click", () => {
          document
            .querySelectorAll("[data-demo]")
            .forEach((b) =>
              b.setAttribute("aria-pressed", String(b === button)),
            );
          const lines = modes[button.dataset.demo as keyof typeof modes];
          const output = document.getElementById("example-output")!;
          Array.from(output.children).forEach((line, index) => {
            line.textContent = lines[index];
          });
        }),
      );
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy]")
      .forEach((button) =>
        button.addEventListener("click", async () => {
          const status = document.getElementById("copy-status")!;
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            status.textContent = "Command copied. Paste it into your terminal.";
            button.textContent = "Copied";
            setTimeout(() => {
              button.textContent = "Copy";
            }, 2000);
          } catch {
            status.textContent =
              "Copy is unavailable here. Select the command above and copy it manually.";
          }
        }),
      );
    document
      .getElementById("session-form")
      ?.addEventListener("submit", (event) => {
        event.preventDefault();
        const token = (
          document.getElementById("token") as HTMLInputElement
        ).value.trim();
        const error = document.getElementById("join-error")!;
        if (!/^[A-Za-z0-9_-]{1,256}$/.test(token)) {
          error.textContent =
            "Enter a session token or name, without a URL or spaces.";
          return;
        }
        error.textContent = "";
        window.location.assign("/s/" + encodeURIComponent(token));
      });
  </script>
</Base>
