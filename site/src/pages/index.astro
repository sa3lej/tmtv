---
import Base from '../layouts/Base.astro';
---

<Base title="tmtv — SSH terminal sharing built on modern tmux">
  <!-- Structured data -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "tmtv",
    "description": "Share your terminal over SSH with tmtv — a modern tmate alternative built on tmux 3.6a. Pair program in your terminal with read-write and read-only SSH tokens.",
    "url": "https://tmtv.se",
    "applicationCategory": "DeveloperApplication",
    "operatingSystem": "Linux, macOS",
    "license": "https://opensource.org/licenses/ISC",
    "softwareVersion": "1.4.1",
    "author": {
      "@type": "Person",
      "name": "Lars-Erik Jonsson",
      "url": "https://github.com/sa3lej"
    },
    "codeRepository": "https://github.com/sa3lej/tmtv",
    "downloadUrl": "https://tmtv.se/install.sh",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  }
  </script>

  <!-- Background gradients -->
  <div class="fixed inset-0 -z-10">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_20%_50%,rgba(40,20,80,0.3)_0%,transparent_60%)]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_50%,rgba(20,40,80,0.2)_0%,transparent_60%)]"></div>
  </div>

  <!-- Hero -->
  <div class="flex flex-col items-center justify-center min-h-[60vh] px-5">
    <h1 class="font-mono text-5xl sm:text-6xl font-bold tracking-tight mb-2 bg-gradient-to-br from-tmtv-blue via-tmtv-purple to-tmtv-green bg-clip-text text-transparent">
      tmtv
    </h1>
    <p class="text-gray-300 text-base tracking-wide font-normal mb-12">
      share your terminal over SSH. that's it.
    </p>

    <!-- SSH quickstart -->
    <div class="bg-tmtv-surface border border-tmtv-border rounded-2xl p-8 sm:p-10 w-[520px] max-w-[90vw] backdrop-blur-xl shadow-2xl">
      <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-4">Get started</h2>
      <div class="bg-black/40 rounded-xl p-4 font-mono text-sm flex items-center justify-between gap-4 mb-5">
        <code class="text-tmtv-green whitespace-nowrap overflow-x-auto">curl -fsSL https://tmtv.se/install.sh | sh</code>
        <button id="copy-btn" class="text-gray-400 hover:text-gray-300 transition-colors shrink-0 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded" aria-label="Copy install command">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        </button>
      </div>
      <div class="bg-black/40 rounded-xl p-4 font-mono text-[13px] text-gray-300 leading-relaxed space-y-1">
        <div><span class="text-gray-400 select-none">$</span> <span class="text-tmtv-green">tmtv</span></div>
        <div><span class="text-gray-400 select-none">#</span> <span class="text-gray-400">share the SSH token with your pair</span></div>
        <div><span class="text-gray-400 select-none">$</span> ssh <span class="text-tmtv-blue">TOKEN</span>@tmtv.se</div>
      </div>
      <p class="mt-3 text-xs text-gray-400">
        Linux and macOS. Or <code class="font-mono bg-white/5 px-1.5 py-0.5 rounded text-[11px] text-gray-300">brew install sa3lej/tap/tmtv</code> on macOS.
        Or build from <a href="https://github.com/sa3lej/tmtv" class="text-gray-300 hover:text-gray-200 transition-colors underline underline-offset-2 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded">source</a>.
      </p>

      <!-- Divider -->
      <div class="border-t border-white/[0.06] my-6"></div>

      <!-- View a session (secondary) -->
      <h3 class="text-[11px] font-medium text-gray-400 tracking-wide mb-3">View a session in the browser</h3>
      <form id="session-form" class="flex gap-2">
        <label for="token" class="sr-only">Session token</label>
        <input
          type="text"
          id="token"
          placeholder="session token"
          autocomplete="off"
          spellcheck="false"
          class="flex-1 bg-white/5 border border-white/[0.06] rounded-lg px-3 py-2.5 font-mono text-xs text-gray-200 placeholder:text-gray-400 outline-none focus:border-tmtv-blue/40 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 transition-colors"
        />
        <button
          type="submit"
          class="bg-white/[0.06] border border-white/[0.08] rounded-lg px-4 py-2.5 text-xs font-medium text-gray-300 hover:bg-white/[0.1] active:scale-[0.97] focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 focus-visible:ring-offset-2 focus-visible:ring-offset-tmtv-bg transition-all whitespace-nowrap"
        >
          Watch
        </button>
      </form>
      <p class="mt-2.5 text-[11px] text-gray-400 leading-relaxed">
        Or open a direct link: <code class="font-mono bg-white/5 px-1.5 py-0.5 rounded text-[11px]">/s/TOKEN</code>
      </p>
    </div>
  </div>

  <!-- Demo GIF -->
  <div class="max-w-2xl mx-auto px-5 pb-16">
    <div class="rounded-xl overflow-hidden border border-white/[0.06] shadow-2xl">
      <img
        src="/tmtv-demo.gif"
        alt="tmtv terminal sharing session — SSH pair programming with optional web viewer"
        class="w-full motion-safe:block motion-reduce:hidden"
      />
    </div>
    <p class="text-center text-[11px] text-gray-400 mt-3 motion-reduce:block hidden motion-reduce:visible">
      <a href="/tmtv-demo.gif" class="underline underline-offset-2 focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded">View demo animation</a>
    </p>
  </div>

  <!-- How it works -->
  <div class="max-w-2xl mx-auto px-5 pb-20">
    <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] text-center mb-8">
      How it works
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      <div class="bg-white/[0.02] border border-white/[0.04] rounded-xl p-6 text-center">
        <div class="font-mono text-2xl font-bold mb-3 bg-gradient-to-br from-tmtv-blue to-tmtv-purple bg-clip-text text-transparent" aria-hidden="true">1</div>
        <h3 class="text-sm font-semibold text-gray-300 mb-2">Share</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Run <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">tmtv</code>.
          You get two SSH tokens: read-write for your pair, read-only for spectators. Add a password if you want to lock the door.
        </p>
      </div>
      <div class="bg-white/[0.02] border border-white/[0.04] rounded-xl p-6 text-center">
        <div class="font-mono text-2xl font-bold mb-3 bg-gradient-to-br from-tmtv-blue to-tmtv-purple bg-clip-text text-transparent" aria-hidden="true">2</div>
        <h3 class="text-sm font-semibold text-gray-300 mb-2">Connect</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Your pair runs <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">ssh TOKEN@tmtv.se</code> and lands in your session. No plugins, no accounts, no browser.
        </p>
      </div>
      <div class="bg-white/[0.02] border border-white/[0.04] rounded-xl p-6 text-center">
        <div class="font-mono text-2xl font-bold mb-3 bg-gradient-to-br from-tmtv-blue to-tmtv-purple bg-clip-text text-transparent" aria-hidden="true">3</div>
        <h3 class="text-sm font-semibold text-gray-300 mb-2">Or use the browser</h3>
        <p class="text-xs text-gray-400 leading-relaxed">
          Open the web viewer if you don't have a terminal handy. Watch, or type along with a read-write token. Zero install.
        </p>
      </div>
    </div>

    <!-- Feature badges -->
    <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mt-6">
      <div class="text-center py-4">
        <div class="text-[11px] font-medium text-gray-400 tracking-wide">SSH sharing</div>
        <div class="font-mono text-xs text-tmtv-green mt-1">read-write + read-only</div>
      </div>
      <div class="text-center py-4">
        <div class="text-[11px] font-medium text-gray-400 tracking-wide">Session security</div>
        <div class="font-mono text-xs text-tmtv-green mt-1">password protection</div>
      </div>
      <div class="text-center py-4">
        <div class="text-[11px] font-medium text-gray-400 tracking-wide">Built on</div>
        <div class="font-mono text-xs text-tmtv-green mt-1">tmux 3.6a</div>
      </div>
      <div class="text-center py-4">
        <div class="text-[11px] font-medium text-gray-400 tracking-wide">Web viewer</div>
        <div class="font-mono text-xs text-tmtv-green mt-1">view or interact, zero install</div>
      </div>
      <div class="text-center py-4">
        <div class="text-[11px] font-medium text-gray-400 tracking-wide">Self-hosting</div>
        <div class="font-mono text-xs text-tmtv-green mt-1">docker compose up</div>
      </div>
    </div>
  </div>

  <!-- CI debugging -->
  <div class="max-w-2xl mx-auto px-5 pb-12">
    <div class="bg-white/[0.02] border border-white/[0.04] rounded-xl p-6">
      <h3 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] mb-3">Debug CI failures</h3>
      <p class="text-xs text-gray-400 leading-relaxed mb-4">
        Drop <code class="font-mono text-[11px] bg-tmtv-blue/10 text-tmtv-blue px-1.5 py-0.5 rounded">sa3lej/action-tmtv@v1</code> into your GitHub Actions workflow. When a job fails, SSH in and debug it live. Drop-in replacement for <code class="font-mono text-[11px] bg-white/5 px-1.5 py-0.5 rounded text-gray-300">action-tmate</code>.
      </p>
      <div class="bg-black/40 rounded-xl p-4 font-mono text-[12px] text-gray-300 leading-relaxed">
        <div><span class="text-tmtv-purple">- name:</span> <span class="text-gray-300">Debug via SSH</span></div>
        <div>&nbsp; <span class="text-tmtv-purple">uses:</span> <span class="text-tmtv-blue">sa3lej/action-tmtv@v1</span></div>
      </div>
    </div>
  </div>

  <!-- Screenshots -->
  <div class="max-w-2xl mx-auto px-5 pb-16">
    <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] text-center mb-6">
      What it looks like
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-xl overflow-hidden border border-white/[0.06]">
        <img src="/screenshot-default.png" alt="tmtv default theme showing terminal output" class="w-full" loading="lazy" />
        <div class="text-center text-[11px] text-gray-400 py-2">Default theme</div>
      </div>
      <div class="rounded-xl overflow-hidden border border-white/[0.06]">
        <img src="/screenshot-tmux.png" alt="tmtv viewer showing a normal tmux session with split panes" class="w-full" loading="lazy" />
        <div class="text-center text-[11px] text-gray-400 py-2">Normal session</div>
      </div>
      <div class="rounded-xl overflow-hidden border border-white/[0.06]">
        <img src="/screenshot-tv.png" alt="tmtv TV theme with rounded corners and CRT effect" class="w-full" loading="lazy" />
        <div class="text-center text-[11px] text-gray-400 py-2">TV theme</div>
      </div>
    </div>
    <p class="text-center text-[11px] text-gray-400 mt-3">
      Try it: add <code class="font-mono bg-white/5 px-1.5 py-0.5 rounded">?theme=tv</code> to any viewer URL
    </p>
  </div>

  <!-- Why tmtv? -->
  <div class="max-w-2xl mx-auto px-5 pb-16">
    <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] text-center mb-6">
      Why tmtv?
    </h2>
    <div class="bg-white/[0.02] border border-white/[0.04] rounded-xl p-8 text-sm text-gray-300 leading-relaxed space-y-3">
      <p>
        I loved <a href="https://github.com/tmate-io/tmate" class="text-tmtv-blue hover:underline focus-visible:ring-2 focus-visible:ring-tmtv-blue/70 rounded">tmate</a> but it was stuck on tmux 2.4 from 2017. Nine years of tmux improvements — popup menus, extended keys, sixel graphics — all missing.
      </p>
      <p>
        So I rebased it on <strong class="text-gray-200">tmux 3.6a</strong> and shipped it. Same SSH-based terminal sharing you know, with a modern tmux underneath. The web viewer is a bonus — handy when someone just wants to watch without opening a terminal.
      </p>
      <p>
        No IDE plugins. No accounts. No Electron app. Just SSH.
      </p>
    </div>
  </div>

  <!-- What's new -->
  <div class="max-w-2xl mx-auto px-5 pb-16">
    <h2 class="text-xs font-medium text-gray-400 uppercase tracking-[0.15em] text-center mb-10">
      What's new
    </h2>

    <!-- Timeline -->
    <div class="relative ml-4 sm:ml-8" role="list" aria-label="Release history">
      <!-- Vertical timeline line -->
      <div class="absolute left-[7px] top-3 bottom-3 w-px bg-gradient-to-b from-tmtv-green via-tmtv-blue to-tmtv-purple/30" aria-hidden="true"></div>

      <!-- Latest release — featured -->
      <div class="relative pl-8 pb-8 group" role="listitem">
        <div class="absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 border-tmtv-green bg-tmtv-bg motion-safe:group-hover:shadow-[0_0_8px_rgba(61,220,132,0.5)] motion-safe:transition-shadow" aria-hidden="true">
          <div class="absolute inset-[3px] rounded-full bg-tmtv-green"></div>
        </div>
        <div class="bg-white/[0.03] border border-tmtv-green/20 rounded-xl p-5 motion-safe:group-hover:border-tmtv-green/40 motion-safe:transition-colors">
          <div class="flex flex-wrap items-center gap-2.5 mb-2">
            <span class="inline-flex items-center font-mono text-xs font-bold bg-tmtv-green/15 text-tmtv-green px-2.5 py-1 rounded-md tracking-wide">v1.4.5</span>
            <span class="text-[11px] font-medium text-tmtv-green/70 uppercase tracking-wider">Latest</span>
          </div>
          <p class="text-[15px] text-gray-200 font-medium leading-snug">The viewer grows up.</p>
        </div>
      </div>

      <!-- v1.4.x releases -->
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.4.4</span>
          <span class="text-sm text-gray-400/80 leading-snug">Your prefix, your rules.</span>
        </div>
      </div>
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.4.3</span>
          <span class="text-sm text-gray-400/80 leading-snug">Sessions that survive the storm.</span>
        </div>
      </div>
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.4.2</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Safe input, fast keys, session lobby.</span>
        </div>
      </div>
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.4.1</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Every key lands where it should.</span>
        </div>
      </div>
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.4.0</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Multiple sessions, web input, rock-solid stability.</span>
        </div>
      </div>

      <!-- v1.3.x releases -->
      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.7</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">The links that finally make sense.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.6</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Stable sessions, snappy input, proper Swedish.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.5</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Web input that actually works.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.3</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">The config that finally clicks.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.2</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">Your server, one command.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.1</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">The server that cleans up after itself.</span>
        </div>
      </div>

      <div class="relative pl-8 pb-5 group" role="listitem">
        <div class="absolute left-[3px] top-2.5 w-[9px] h-[9px] rounded-full bg-tmtv-blue/60 motion-safe:group-hover:bg-tmtv-blue motion-safe:transition-colors" aria-hidden="true"></div>
        <div class="flex flex-wrap items-baseline gap-3 py-1 motion-safe:group-hover:translate-x-1 motion-safe:transition-transform">
          <span class="font-mono text-xs font-semibold text-tmtv-blue/80 shrink-0">v1.3.0</span>
          <span class="text-sm text-gray-300 motion-safe:group-hover:text-gray-200 motion-safe:transition-colors">The viewer learns to type.</span>
        </div>
      </div>

      <!-- Minor version divider -->
      <div class="relative pl-8 pb-4" aria-hidden="true">
        <div class="absolute left-[3px] top-2 w-[9px] h-[1px] bg-white/10"></div>
        <div class="border-t border-white/[0.04] ml-1"></div>
      </div>

