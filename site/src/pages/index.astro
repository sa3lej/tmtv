---
import Base from "../layouts/Base.astro";
import { release } from "../data/release";

const site = "https://tmtv.se/";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}#website`,
    name: "tmtv",
    url: site,
    inLanguage: "en",
    publisher: { "@id": `${site}#author` },
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "@id": `${site}#software`,
    name: "tmtv",
    description:
      "Open-source terminal sharing built on tmux 3.8. Share a tmux session over SSH with read-write and read-only tokens, or in a browser.",
    url: site,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Linux, macOS",
    softwareVersion: release.current,
    downloadUrl: "https://github.com/sa3lej/tmtv/releases/latest",
    installUrl: "https://tmtv.se/install.sh",
    releaseNotes: "https://tmtv.se/releases/3-0/",
    license: "https://opensource.org/license/isc-license-txt",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    sameAs: [release.repository],
    author: { "@id": `${site}#author` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${site}#author`,
    name: "Lars-Erik Jonsson",
    url: "https://github.com/sa3lej",
  },
];
---

<Base
  title="tmtv — share a tmux session over SSH or in a browser"
  description="tmtv shares your terminal. Run tmtv and it prints an ssh command for people who should type and one for people who should only watch. Open source, built on tmux 3.8, for Linux and macOS."
  jsonLd={schema}
>
  <section class="section lead-section" aria-labelledby="name">
    <div class="lead-body">
      <h1 id="name">Share a tmux session over SSH or in a browser.</h1>
      <p class="lead">
        Run <code>tmtv</code> and it prints two ssh commands: one for people who
        should type, one for people who should only watch. Guests need nothing
        but <code>ssh</code>. Built on tmux 3.8, ISC licensed, runs on Linux and
        macOS.
      </p>
      <p class="meta">
        Current release {release.current} ·
        <a href="/releases/3-0/">what changed in 3.0</a> ·
        <a href="#join">join a session</a>
      </p>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-title">
    <h2 id="install-title">Install</h2>
    <div class="section-body">
      <div class="command">
        <code tabindex="0">{release.installer}</code>
        <button class="copy" type="button" data-copy={release.installer}>
          Copy<span class="visually-hidden"> install command</span>
        </button>
      </div>
      <div class="command">
        <code tabindex="0">{release.homebrew}</code>
        <button class="copy" type="button" data-copy={release.homebrew}>
          Copy<span class="visually-hidden"> Homebrew command</span>
        </button>
      </div>
      <p class="copy-status" role="status" aria-live="polite"></p>
      <p>
        The script downloads the published release for your platform, checks its
        SHA-256 checksum and installs nothing if the check fails.
        <a href="/install.sh">Read install.sh</a> before you run it, or download
        <a href="https://github.com/sa3lej/tmtv/releases/latest">binaries and checksums</a>
        from GitHub. People who only join a session do not need to install anything.
      </p>
    </div>
  </section>

  <section class="section" id="start" aria-labelledby="start-title">
    <h2 id="start-title">Start sharing</h2>
    <div class="section-body">
      <pre class="terminal" tabindex="0" aria-label="Terminal output of tmtv"><code><span class="p">$ </span>tmtv
ssh TOKEN@tmtv.se     <span class="c"># read-write access</span>
ssh ro-TOKEN@tmtv.se  <span class="c"># read-only access</span></code></pre>
      <p>
        <code>tmtv</code> starts tmux, connects to the relay at tmtv.se and
        prints your tokens. Send the first line to someone you want to type
        with and the second to someone who should only watch. Treat tokens like
        passwords: anyone who has one can join. The status bar shows how many
        people are watching, for example <code>S:2 W:1</code> for two over SSH
        and one in a browser.
      </p>
      <p>Browser sharing is off until you turn it on:</p>
      <pre class="terminal" tabindex="0" aria-label="Turning on web sharing"><code><span class="p">$ </span>tmtv set -g tmtv-web-sharing on
[tmtv] web session: https://tmtv.se/s/TOKEN</code></pre>
      <p>
        People who open the link watch in their browser without installing
        anything. They can only watch until you run
        <code>tmtv set -g tmtv-web-input on</code>; after that, anyone with the
        printed web link can type.
      </p>
      <p>
        To stop sharing, exit tmtv. Starting it again gives you new links.
      </p>
    </div>
  </section>

  <section class="section" id="how" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <div class="section-body">
      <pre class="terminal" tabindex="0" aria-label="Diagram: your machine and every guest connect to the relay; the relay checks tokens and passwords and forwards the terminal between them."><code>your machine: tmtv + tmux
     │
     │ ssh
     ▼
relay (tmtv.se): checks tokens
     ▲                  ▲
     │ ssh              │ https
     │                  │
guest                 browser
ssh TOKEN@tmtv.se     tmtv.se/s/TOKEN</code></pre>
      <p>
        Your shell and programs run on your machine. tmtv opens an SSH
        connection to a relay, and guests connect to the same relay. The relay
        checks each guest's token and password, then forwards the terminal
        between you. Browsers get the same screen over HTTPS, drawn with
        xterm.js.
      </p>
      <p>
        <strong>The relay can read your terminal.</strong> SSH encrypts each
        connection, but it is not end-to-end encryption between you and your
        guests. Use the public relay for things you would be comfortable
        sharing with its operator, or run your own: <code>docker compose up -d</code>
        in a checkout starts one with SSH on port 2222. The
        <a href="https://github.com/sa3lej/tmtv#self-hosting">self-hosting guide</a>
        covers TLS, web viewing and systemd.
      </p>
    </div>
  </section>

  <section class="section" id="options" aria-labelledby="options-title">
    <h2 id="options-title">Options</h2>
    <div class="section-body">
      <p>
        Settings go in <code>~/.tmtv.conf</code>. Web sharing, web input,
        recording and the shared clipboard can also be switched in a running
        session by putting <code>tmtv</code> in front, as in
        <code>tmtv set -g tmtv-recording on</code>.
      </p>
      <div class="option">
        <h3 id="password">Require a password</h3>
        <p>SSH viewers must enter it, and browser viewers get a prompt before the terminal loads. Either start with <code>tmtv -p secret</code> or set it in the config:</p>
        <pre class="conf"><code>set -g tmtv-session-password secret</code></pre>
      </div>
      <div class="option">
        <h3 id="name-option">Use a name instead of a random token</h3>
        <p>
          Gives you <code>ssh ro-demo@tmtv.se</code> and
          <code>https://tmtv.se/s/demo</code>; the read-write SSH link keeps a
          32-character random prefix. Names are 3–32 letters, digits or
          hyphens. They are easy to guess, and they are not reserved: while your
          host is offline someone else can use the name. Set a password,
          especially with web input on.
        </p>
        <pre class="conf"><code>set -g tmtv-session-name demo</code></pre>
      </div>
      <div class="option">
        <h3 id="record">Record the session</h3>
        <p>Writes an asciinema <code>.cast</code> file to <code>~/.tmtv/recordings/</code>.</p>
        <pre class="conf"><code>set -g tmtv-recording on</code></pre>
      </div>
      <div class="option">
        <h3 id="ttl">End the session after a while</h3>
        <p>Time to live in seconds. Viewers see the countdown.</p>
        <pre class="conf"><code>set -g tmtv-link-ttl 3600</code></pre>
      </div>
      <div class="option">
        <h3 id="clipboard">Turn off the shared clipboard</h3>
        <p>On by default. Read-only viewers never get it.</p>
        <pre class="conf"><code>set -g tmtv-shared-clipboard off</code></pre>
      </div>
      <p>
        If the connection drops, the same running host reconnects and keeps its
        links. The <a href="https://github.com/sa3lej/tmtv#readme">README</a>
        covers status bar variables, the per-user input API and using tmtv as
        plain tmux.
      </p>
    </div>
  </section>

  <section class="section" id="ci" aria-labelledby="ci-title">
    <h2 id="ci-title">GitHub Actions</h2>
    <div class="section-body">
      <p>
        <a href="https://github.com/sa3lej/action-tmtv">action-tmtv</a> opens a
        tmtv session on a failed GitHub Actions runner so you can ssh in and
        look around. Coming from action-tmate, the change is one line:
      </p>
      <pre class="terminal" tabindex="0" aria-label="Workflow change from action-tmate to action-tmtv"><code><span class="del">- uses: mxschmitt/action-tmate@v3</span>
<span class="add">+ uses: sa3lej/action-tmtv@v1</span></code></pre>
    </div>
  </section>

  <section class="section" id="join" aria-labelledby="join-title">
    <h2 id="join-title">Join a session</h2>
    <div class="section-body">
      <p>
        If someone sent you a link, a token or a session name and has web
        sharing turned on, you can watch in this browser. Over SSH, run the
        <code>ssh</code> command they sent instead.
      </p>
      <form class="join-form" id="session-form" novalidate>
        <label for="token">Link, token or session name</label>
        <div class="join-row">
          <input
            id="token"
            name="token"
            type="text"
            required
            maxlength="512"
            placeholder="for example demo"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            aria-describedby="join-error"
          />
          <button class="button" type="submit">Open</button>
        </div>
        <p class="form-error" id="join-error" role="alert"></p>
      </form>
    </div>
  </section>

  <script>
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) =>
      button.addEventListener("click", async () => {
        const status = document.querySelector(".copy-status");
        const label = button.firstChild!;
        try {
          await navigator.clipboard.writeText(button.dataset.copy!);
          if (status) status.textContent = "Copied to the clipboard.";
          label.textContent = "Copied";
          setTimeout(() => {
            label.textContent = "Copy";
          }, 2000);
        } catch {
          if (status) status.textContent = "Could not copy. Select the command and copy it by hand.";
        }
      }),
    );
    const form = document.getElementById("session-form") as HTMLFormElement | null;
    const input = document.getElementById("token") as HTMLInputElement | null;
    const error = document.getElementById("join-error");
    // Accept what guests are actually sent: a bare token or name, a /s/ or /j/
    // link, or an ssh command. The token is kept whole (a read-only "ro-" token
    // stays read-only) and the link's own path is preserved.
    const parseInvite = (value: string) => {
      const text = value.trim();
      if (/^https?:\/\//i.test(text)) {
        let url: URL;
        try {
          url = new URL(text);
        } catch {
          return null;
        }
        if (url.host !== window.location.host) return { other: url.href };
      }
      const link = text.match(/\/(s|j)\/([A-Za-z0-9_-]{1,256})\/?(?:[?#].*)?$/);
      if (link) return { path: link[1], token: link[2] };
      const ssh = text.match(/^(?:ssh\s+)?([A-Za-z0-9_-]{1,256})@[A-Za-z0-9.-]+(?:\s+-p\s*\d+)?$/);
      if (ssh) return { path: "s", token: ssh[1] };
      if (/^[A-Za-z0-9_-]{1,256}$/.test(text)) return { path: "s", token: text };
      return null;
    };
    const showError = (message: string) => {
      error!.textContent = message;
      input!.setAttribute("aria-invalid", "true");
      input!.focus();
    };
    input?.addEventListener("input", () => {
      error!.textContent = "";
      input.removeAttribute("aria-invalid");
    });
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!input!.value.trim()) {
        showError("Paste the link, token or session name you were sent.");
        return;
      }
      const invite = parseInvite(input!.value);
      if (!invite) {
        showError("That does not look like a tmtv link, token or session name.");
        return;
      }
      if ("other" in invite) {
        showError("That link is for another relay. Open it directly in your browser.");
        return;
      }
      window.location.assign("/" + invite.path + "/" + encodeURIComponent(invite.token));
    });
  </script>
</Base>
